function agregarTexto() {
    let texto = prompt("Ingrese un texto:");
    let fragmento = prompt("Ingrese un fragmento:");
    
    let textoInicio = "";
    for (let i = 0; i < fragmento.length; i++) {
        textoInicio += fragmento[i];
    }
    textoInicio += " ";
    for (let i = 0; i < texto.length; i++) {
        textoInicio += texto[i];
    }
    
    let textoFinal = "";
    for (let i = 0; i < texto.length; i++) {
        textoFinal += texto[i];
    }
    textoFinal += " ";
    for (let i = 0; i < fragmento.length; i++) {
        textoFinal += fragmento[i];
    }
    
    console.log(`Al inicio: "${textoInicio}"\nAl final: "${textoFinal}"`);
}

