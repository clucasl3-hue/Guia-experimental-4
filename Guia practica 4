function contarPalabras(texto) {
  let palabras = [];
  let palabraActual = "";
  for (let i = 0; i < texto.length; i++) {
    let caracter = texto[i];
    if (caracter !== " " && caracter !== "\n") {
      palabraActual += caracter;
    } else {
      if (palabraActual.length > 0) {
        palabras.push(palabraActual);
        palabraActual = "";
      }
    }
  }
  if (palabraActual.length > 0) {
    palabras.push(palabraActual);
  }
  alert("Número de palabras: " + palabras.length);
}
contarPalabras("Hola mundo desde Quito");

function contarSignosPuntuacion(texto) {
  let signos = ['.', ',', ';', ':', '!', '?', '¿', '¡', '"'];
  let encontrados = [];
  for (let i = 0; i < texto.length; i++) {
    let caracter = texto[i];
    for (let j = 0; j < signos.length; j++) {
      if (caracter === signos[j]) {
        encontrados.push(caracter);
      }
    }
  }
  alert("Signos de puntuación: " + encontrados.length);
}
contarSignosPuntuacion('Hola, ¿cómo estás?');

