function contarConsonantes(texto) {
    texto = texto.toLowerCase();
    const vocales = "aeiou";
    let contador = 0;
    for (let i = 0; i < texto.length; i++) {
        let letra = texto[i];
        if (letra >= "a" && letra <= "z") {
            if(letra != "a" && letra != "e" && letra != "i" && letra != "o" && letra != "u"){
                contador++;
            }
        }
    }
    return contador;
}
let palabra = "Hola";
console.log("Cantidad de consonates:" , contarConsonantes(palabra));

function contarDigitos(texto) {
    let contador = 0;
    for (let i = 0; i < texto.length; i++) {
        let caracter = texto[i];
        if (caracter >= "0" && caracter <= "9") {
            contador++;
        }
    }
    return contador;
}
let frase = "Mi clave es 1234";
console.log("Cantidad de digitos:", contarDigitos(frase));

function contarMayusculas(texto) {
    let palabras = texto.split(" ");
    let contador = 0;
    for (let i = 0; i < palabras.length; i++) {
        let palabra = palabras[i];
        if (palabra.length > 0) {
            let primera = palabra[0];
            if (primera >= "A" && primera <= "Z") {
                contador++;
            }
        }
    }
    return contador;
}
let texto = "Hola mundo Bonito";
console.log("Palabras con mayuscula incial:", contarMayusculas(texto));

